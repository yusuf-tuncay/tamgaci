rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public metadata for registration (cities/districts/tax offices)
    match /geo_cities/{docId} {
      allow read: if true;       // Public read for dropdowns before auth
      allow write: if isAdmin(); // Manage via admin/tools only
    }
    match /metadata/{docId} {
      allow read: if true;       // e.g., tax_offices
      allow write: if isAdmin();
    }
    
    function isSignedIn() { return request.auth != null; }
    function userId() { return request.auth.uid; }
    function isOwner(resourceData) { return resourceData.createdBy == userId(); }
    function isAdmin() { return request.auth.token.role == 'admin'; }
    
    // Multi-tenant functions
    function getUserTenantId() {
      return get(/databases/$(database)/documents/users/$(userId())).data.tenantId;
    }
    function isSameTenant(resourceData) {
      return resourceData.tenantId == getUserTenantId();
    }
    function isSameTenantOrAdmin(resourceData) {
      return isAdmin() || isSameTenant(resourceData);
    }
    function isAuthenticatedUser() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(userId()));
    }
    function isTenantOwner(tenantId) {
      // Basit kontrol: kullanıcının tenantId'si ile eşleşiyor mu?
      return getUserTenantId() == tenantId;
    }
    function isTenantMember(tenantId) {
      // Basit kontrol: kullanıcının tenantId'si ile eşleşiyor mu?
      return getUserTenantId() == tenantId;
    }

    // Generic helpers - Multi-tenant aware
    function allowRead(doc) {
      return isSignedIn() && isSameTenantOrAdmin(doc.data);
    }
    function allowDelete(doc) {
      return isSignedIn() && isSameTenantOrAdmin(doc.data) && isOwner(doc.data);
    }
    function isValidCreate() {
      return isSignedIn() &&
             request.resource.data.createdBy == userId() &&
             request.resource.data.tenantId == getUserTenantId() &&
             (request.resource.data.createdAt == null || request.resource.data.createdAt is timestamp) &&
             (request.resource.data.updatedAt == null || request.resource.data.updatedAt is timestamp) &&
             (request.resource.data.updatedBy == null || request.resource.data.updatedBy == userId()) &&
             (request.resource.data.isActive == null || request.resource.data.isActive is bool);
    }
    function allowUpdate(doc) {
      return isSignedIn() && isSameTenantOrAdmin(doc.data) && isOwner(doc.data) &&
             request.resource.data.createdBy == doc.data.createdBy &&
             request.resource.data.tenantId == doc.data.tenantId &&
             request.resource.data.createdAt == doc.data.createdAt &&
             (request.resource.data.updatedAt is timestamp) &&
             (request.resource.data.isActive == null || request.resource.data.isActive is bool);
    }

    // Tenants
    match /tenants/{tenantId} {
      allow read: if isSignedIn() && (isTenantMember(tenantId) || isAdmin());
      allow create: if isSignedIn() && request.resource.data.ownerId == userId();
      allow update: if isSignedIn() && (isTenantOwner(tenantId) || isAdmin());
      allow delete: if isSignedIn() && (isTenantOwner(tenantId) || isAdmin());
    }

    // Tenant-based collections
    match /tenants/{tenantId}/products/{id} {
      allow get, list: if isSignedIn() && isTenantMember(tenantId);
      allow create: if isSignedIn() && isTenantMember(tenantId) && 
                       request.resource.data.tenantId == tenantId &&
                       request.resource.data.createdBy == userId();
      allow update: if isSignedIn() && isTenantMember(tenantId) && isOwner(resource.data);
      allow delete: if isSignedIn() && isTenantMember(tenantId) && isOwner(resource.data);
    }

    match /tenants/{tenantId}/customers/{id} {
      allow get, list: if isSignedIn() && isTenantMember(tenantId);
      allow create: if isSignedIn() && isTenantMember(tenantId) && 
                       request.resource.data.tenantId == tenantId &&
                       request.resource.data.createdBy == userId();
      allow update: if isSignedIn() && isTenantMember(tenantId) && isOwner(resource.data);
      allow delete: if isSignedIn() && isTenantMember(tenantId) && isOwner(resource.data);
    }

    match /tenants/{tenantId}/suppliers/{id} {
      allow get, list: if isSignedIn() && isTenantMember(tenantId);
      allow create: if isSignedIn() && isTenantMember(tenantId) && 
                       request.resource.data.tenantId == tenantId &&
                       request.resource.data.createdBy == userId();
      allow update: if isSignedIn() && isTenantMember(tenantId) && isOwner(resource.data);
      allow delete: if isSignedIn() && isTenantMember(tenantId) && isOwner(resource.data);
    }

    match /tenants/{tenantId}/sales/{id} {
      allow get, list: if isSignedIn() && isTenantMember(tenantId);
      allow create: if isSignedIn() && isTenantMember(tenantId) && 
                       request.resource.data.tenantId == tenantId &&
                       request.resource.data.createdBy == userId();
      allow update: if isSignedIn() && isTenantMember(tenantId) && isOwner(resource.data);
      allow delete: if isSignedIn() && isTenantMember(tenantId) && isOwner(resource.data);
    }

    match /tenants/{tenantId}/purchases/{id} {
      allow get, list: if isSignedIn() && isTenantMember(tenantId);
      allow create: if isSignedIn() && isTenantMember(tenantId) && 
                       request.resource.data.tenantId == tenantId &&
                       request.resource.data.createdBy == userId();
      allow update: if isSignedIn() && isTenantMember(tenantId) && isOwner(resource.data);
      allow delete: if isSignedIn() && isTenantMember(tenantId) && isOwner(resource.data);
    }

    match /tenants/{tenantId}/payments/{id} {
      allow get, list: if isSignedIn() && isTenantMember(tenantId);
      allow create: if isSignedIn() && isTenantMember(tenantId) && 
                       request.resource.data.tenantId == tenantId &&
                       request.resource.data.createdBy == userId();
      allow update: if isSignedIn() && isTenantMember(tenantId) && isOwner(resource.data);
      allow delete: if isSignedIn() && isTenantMember(tenantId) && isOwner(resource.data);
    }

    match /tenants/{tenantId}/cash_accounts/{id} {
      allow get, list: if isSignedIn() && isTenantMember(tenantId);
      allow create: if isSignedIn() && isTenantMember(tenantId) && 
                       request.resource.data.tenantId == tenantId &&
                       request.resource.data.createdBy == userId();
      allow update: if isSignedIn() && isTenantMember(tenantId) && isOwner(resource.data);
      allow delete: if isSignedIn() && isTenantMember(tenantId) && isOwner(resource.data);
    }

    match /tenants/{tenantId}/cash_transactions/{id} {
      allow get, list: if isSignedIn() && isTenantMember(tenantId);
      allow create: if isSignedIn() && isTenantMember(tenantId) && 
                       request.resource.data.tenantId == tenantId &&
                       request.resource.data.createdBy == userId();
      allow update: if isSignedIn() && isTenantMember(tenantId) && isOwner(resource.data);
      allow delete: if isSignedIn() && isTenantMember(tenantId) && isOwner(resource.data);
    }

    // Yeni Accounts modülü için güvenlik kuralları
    match /tenants/{tenantId}/accounts/{id} {
      allow get, list: if isSignedIn() && isTenantMember(tenantId);
      allow create: if isSignedIn() && isTenantMember(tenantId) && 
                       request.resource.data.tenantId == tenantId &&
                       request.resource.data.createdBy == userId();
      allow update: if isSignedIn() && isTenantMember(tenantId) && isOwner(resource.data);
      allow delete: if isSignedIn() && isTenantMember(tenantId) && isOwner(resource.data);
      // Realtime listener için gerekli izinler
      allow read: if isSignedIn() && isTenantMember(tenantId);
    }

    match /tenants/{tenantId}/accountTransactions/{id} {
      allow get, list: if isSignedIn() && isTenantMember(tenantId);
      allow create: if isSignedIn() && isTenantMember(tenantId) && 
                       request.resource.data.tenantId == tenantId &&
                       request.resource.data.createdBy == userId();
      allow update: if isSignedIn() && isTenantMember(tenantId) && isOwner(resource.data);
      allow delete: if isSignedIn() && isTenantMember(tenantId) && isOwner(resource.data);
      // Realtime listener için gerekli izinler
      allow read: if isSignedIn() && isTenantMember(tenantId);
    }

    // Warehouses collection rules
    match /tenants/{tenantId}/warehouses/{id} {
      allow get, list: if isSignedIn() && isTenantMember(tenantId);
      allow create: if isSignedIn() && isTenantMember(tenantId) && 
                       request.resource.data.tenantId == tenantId &&
                       request.resource.data.createdBy == userId();
      allow update: if isSignedIn() && isTenantMember(tenantId) && isOwner(resource.data);
      allow delete: if isSignedIn() && isTenantMember(tenantId) && isOwner(resource.data);
    }

    // Warehouse Transfers collection rules
    match /tenants/{tenantId}/warehouseTransfers/{id} {
      allow get, list: if isSignedIn() && isTenantMember(tenantId);
      allow create: if isSignedIn() && isTenantMember(tenantId) && 
                       request.resource.data.tenantId == tenantId &&
                       request.resource.data.createdBy == userId();
      allow update: if isSignedIn() && isTenantMember(tenantId) && isOwner(resource.data);
      allow delete: if isSignedIn() && isTenantMember(tenantId) && isOwner(resource.data);
    }

    match /tenants/{tenantId}/invoices/{id} {
      allow get, list: if isSignedIn() && isTenantMember(tenantId);
      allow create: if isSignedIn() && isTenantMember(tenantId) && 
                       request.resource.data.tenantId == tenantId &&
                       request.resource.data.createdBy == userId();
      allow update: if isSignedIn() && isTenantMember(tenantId) && isOwner(resource.data);
      allow delete: if isSignedIn() && isTenantMember(tenantId) && isOwner(resource.data);
    }

    match /tenants/{tenantId}/inventory_items/{id} {
      allow get, list: if isSignedIn() && isTenantMember(tenantId);
      allow create: if isSignedIn() && isTenantMember(tenantId) && 
                       request.resource.data.tenantId == tenantId &&
                       request.resource.data.createdBy == userId();
      allow update: if isSignedIn() && isTenantMember(tenantId) && isOwner(resource.data);
      allow delete: if isSignedIn() && isTenantMember(tenantId) && isOwner(resource.data);
    }

    match /tenants/{tenantId}/reports/{id} {
      allow get, list: if isSignedIn() && isTenantMember(tenantId);
      allow create: if isSignedIn() && isTenantMember(tenantId) && 
                       request.resource.data.tenantId == tenantId &&
                       request.resource.data.createdBy == userId();
      allow update: if isSignedIn() && isTenantMember(tenantId) && isOwner(resource.data);
      allow delete: if isSignedIn() && isTenantMember(tenantId) && isOwner(resource.data);
    }

    // Customer Categories
    match /tenants/{tenantId}/customer_categories/{id} {
      allow get, list: if isSignedIn() && isTenantMember(tenantId);
      allow create: if isSignedIn() && isTenantMember(tenantId) && 
                       request.resource.data.tenantId == tenantId &&
                       request.resource.data.createdBy == userId();
      allow update: if isSignedIn() && isTenantMember(tenantId) && isOwner(resource.data);
      allow delete: if isSignedIn() && isTenantMember(tenantId) && isOwner(resource.data);
    }

    // Users
    match /users/{uid} {
      allow read: if isSignedIn() && (uid == userId() || isAdmin());
      allow create: if isSignedIn() && uid == userId();
      allow update: if isSignedIn() && uid == userId();
      allow delete: if isAdmin();
    }
    match /report_templates/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Settings
    match /app_settings/{uid} {
      // Geçici: varsayılan kullanıcı yapısı kullanıldığı için okuma tüm authenticated kullanıcılara açık
      allow read: if isSignedIn();
      // Yazma: sadece kendi ayarını yazsın
      allow write: if isSignedIn() && uid == userId();
    }

    // Product Movements - Ürün hareketleri
    match /productMovements/{movementId} {
      allow read, write: if isSignedIn();
    }
    match /system_settings/{docId} {
      // Sistem ayarlarını tüm kullanıcılar okuyabilir (veya isSignedIn())
      allow read: if true;
      // Yazma sadece admin
      allow write: if isAdmin();
    }
    // Users (Auth profile documents)
    match /users/{uid} {
      allow read: if isSignedIn() && (uid == userId() || isAdmin());
      allow create: if isSignedIn() && uid == userId();
      allow update: if isSignedIn() && uid == userId();
      allow delete: if isAdmin();
    }
    match /user_profiles/{uid} {
      allow read: if isSignedIn() && (uid == userId() || isAdmin());
      allow create: if isSignedIn() && request.resource.data.id == userId();
      allow update: if isSignedIn() && uid == userId();
      allow delete: if isAdmin();
    }
    
    // Income collection rules
    match /tenants/{tenantId}/incomes/{id} {
      allow read, write: if isSignedIn() && isTenantMember(tenantId);
    }
    
    // Inventory/Stock collection rules
    match /tenants/{tenantId}/inventory/{id} {
      allow get, list: if isSignedIn() && isTenantMember(tenantId);
      allow create: if isSignedIn() && isTenantMember(tenantId) && 
                       request.resource.data.tenantId == tenantId &&
                       request.resource.data.createdBy == userId();
      allow update: if isSignedIn() && isTenantMember(tenantId) && isOwner(resource.data);
      allow delete: if isSignedIn() && isTenantMember(tenantId) && isOwner(resource.data);
    }
    
    match /tenants/{tenantId}/stock_movements/{id} {
      allow get, list: if isSignedIn() && isTenantMember(tenantId);
      allow create: if isSignedIn() && isTenantMember(tenantId) && 
                       request.resource.data.tenantId == tenantId &&
                       request.resource.data.createdBy == userId();
      allow update: if isSignedIn() && isTenantMember(tenantId) && isOwner(resource.data);
      allow delete: if isSignedIn() && isTenantMember(tenantId) && isOwner(resource.data);
    }
    
    // Stock Counts - Stok sayımları
    match /tenants/{tenantId}/stockCounts/{id} {
      allow read, write: if isSignedIn();
    }
    
    // Expense collection rules
    match /tenants/{tenantId}/expenses/{id} {
      allow read, write: if isSignedIn() && isTenantMember(tenantId);
    }

    // Transactions collection rules
    match /tenants/{tenantId}/transactions/{id} {
      allow get, list: if isSignedIn() && isTenantMember(tenantId);
      allow create: if isSignedIn() && isTenantMember(tenantId) && 
                       request.resource.data.tenantId == tenantId &&
                       request.resource.data.createdBy == userId();
      allow update: if isSignedIn() && isTenantMember(tenantId) && isOwner(resource.data);
      allow delete: if isSignedIn() && isTenantMember(tenantId) && isOwner(resource.data);
    }

    // Stock movements collection rules
    match /tenants/{tenantId}/stock_movements/{id} {
      allow get, list: if isSignedIn() && isTenantMember(tenantId);
      allow create: if isSignedIn() && isTenantMember(tenantId) && 
                       request.resource.data.tenantId == tenantId &&
                       request.resource.data.createdBy == userId();
      allow update: if isSignedIn() && isTenantMember(tenantId) && isOwner(resource.data);
      allow delete: if isSignedIn() && isTenantMember(tenantId) && isOwner(resource.data);
    }

    // Cash accounts collection rules
    match /tenants/{tenantId}/cash_accounts/{id} {
      allow get, list: if isSignedIn() && isTenantMember(tenantId);
      allow create: if isSignedIn() && isTenantMember(tenantId) && 
                       request.resource.data.tenantId == tenantId &&
                       request.resource.data.createdBy == userId();
      allow update: if isSignedIn() && isTenantMember(tenantId) && isOwner(resource.data);
      allow delete: if isSignedIn() && isTenantMember(tenantId) && isOwner(resource.data);
    }

    // Products collection rules
    match /tenants/{tenantId}/products/{id} {
      allow get, list: if isSignedIn() && isTenantMember(tenantId);
      allow create: if isSignedIn() && isTenantMember(tenantId) && 
                       request.resource.data.tenantId == tenantId &&
                       request.resource.data.createdBy == userId();
      allow update: if isSignedIn() && isTenantMember(tenantId) && isOwner(resource.data);
      allow delete: if isSignedIn() && isTenantMember(tenantId) && isOwner(resource.data);
    }

    // Company info collection rules
    match /tenants/{tenantId}/companies/{id} {
      allow get, list: if isSignedIn() && isTenantMember(tenantId);
      allow create: if isSignedIn() && isTenantMember(tenantId) && 
                       request.resource.data.tenantId == tenantId &&
                       request.resource.data.createdBy == userId();
      allow update: if isSignedIn() && isTenantMember(tenantId) && isOwner(resource.data);
      allow delete: if isSignedIn() && isTenantMember(tenantId) && isOwner(resource.data);
    }

    // Subscriptions collection rules - Global subscription management
    match /subscriptions/{subscriptionId} {
      // Kullanıcılar kendi aboneliklerini okuyabilir
      allow read: if isSignedIn() && resource.data.userId == userId();
      // Sadece admin veya sistem abonelik oluşturabilir/güncelleyebilir
      allow create, update: if isSignedIn() && (isAdmin() || request.resource.data.userId == userId());
      // Sadece admin silebilir
      allow delete: if isSignedIn() && isAdmin();
    }

    // Subscription updates collection - Real-time updates
    match /subscription_updates/{userId} {
      // Kullanıcılar kendi güncellemelerini okuyabilir
      allow read: if isSignedIn() && userId == userId();
      // Cloud Functions ve kullanıcılar güncelleme oluşturabilir
      allow create, update: if isSignedIn() && (isAdmin() || request.resource.data.userId == userId() || userId == userId());
      // Sadece admin silebilir
      allow delete: if isSignedIn() && isAdmin();
    }
  }
}
