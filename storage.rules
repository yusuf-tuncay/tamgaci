rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Profile images - allow public read, authenticated write
    match /users/{userId}/profile/{allPaths=**} {
      allow read: if true; // Public read for profile images
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Legacy profile images - allow public read, authenticated write
    match /profile_images/{allPaths=**} {
      allow read: if true; // Public read for legacy profile images
      allow write: if request.auth != null;
    }
    
    // All other files - authenticated only
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
